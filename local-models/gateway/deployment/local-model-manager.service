[Unit]
Description=Local GPU inference manager
After=network-online.target
[Service]
Type=simple
User=local-models
Group=local-models
WorkingDirectory=/opt/device-poc/local-models
ExecStart=/opt/device-poc/local-models/.venv/bin/python -m service.daemon --root /var/lib/local-models --start-selected llm asr tts
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
