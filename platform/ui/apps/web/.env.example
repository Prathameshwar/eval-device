# Server-only URL; remote deployments require HTTPS.
PMS_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional, intentionally public landing-page information. Never put credentials here.
PMS_PUBLIC_CONTACT_EMAIL=contact@aieval.com
PMS_PUBLIC_OPERATOR_NAME=AI Evaluator Company
# HTTPS origin, without path, credentials, query string or fragment.
PMS_PUBLIC_SITE_URL=https://eval.centralindia.cloudapp.azure.com/
# Leave blank to use the included product-information pages.
PMS_PUBLIC_PRIVACY_URL=
PMS_PUBLIC_TERMS_URL=
# Opt in only after deployment-specific content and public indexing are approved.
PMS_PUBLIC_INDEXING_ENABLED=false
