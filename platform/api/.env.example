# Generate independent local secrets with: uv run pms-admin init-local
PMS_ENVIRONMENT=local
PMS_BIND_HOST=127.0.0.1
PMS_PORT=8000
PMS_DATABASE_URL=postgresql+psycopg://pms_api@127.0.0.1:5432/device_platform
PMS_WORKER_DATABASE_URL=postgresql+psycopg://pms_worker@127.0.0.1:5432/device_platform
PMS_RETENTION_DATABASE_URL=postgresql+psycopg://pms_retention@127.0.0.1:5432/device_platform
# Owner URL used only for migrations, adoption and initial administrator bootstrap.
PMS_MIGRATION_DATABASE_URL=postgresql+psycopg://pms_owner@127.0.0.1:5432/device_platform
PMS_TOKEN_PEPPER=
PMS_MEDIA_SIGNING_KEY=
PMS_ACTIVE_CREDENTIAL_KEY=v1
# JSON mapping: key ID -> base64 of 32 cryptographically random bytes.
PMS_CREDENTIAL_KEYS={}
PMS_OIDC_ISSUER=
PMS_OIDC_AUDIENCE=
PMS_LOCAL_AUTH_ENABLED=true
# First-run web setup: an independent random secret (32-512 ASCII characters, no spaces).
# init-local generates it privately. Paste into /setup; remove after setup if desired.
# No administrator email or password is seeded from environment configuration.
PMS_INITIAL_SETUP_KEY=
PMS_LOCAL_TOKEN_SIGNING_KEY=
PMS_LOCAL_ACCESS_MINUTES=15
PMS_LOCAL_REFRESH_DAYS=30
PMS_LOCAL_BROWSER_SESSION_HOURS=24
PMS_ACCOUNT_ACTION_HOURS=24
PMS_ACCOUNT_ACTION_BASE_URL=http://localhost:3000/account
PMS_EXTERNAL_CALLS_ENABLED=false
PMS_PROCESSING_MODE=local
PMS_SPEECH_ENABLED=false
PMS_SPEECH_MAX_SECONDS=30
PMS_SPEECH_DAILY_SECONDS=3600
PMS_SPEECH_CONCURRENCY=2
PMS_SPEECH_RECORDING_MAX_BYTES=100000000
PMS_SPEECH_RETENTION_DAYS=7
PMS_LLM_CLOUD_CONCURRENCY=4
PMS_STORAGE_BACKEND=local
PMS_STORAGE_ROOT=.local/media
PMS_PUBLIC_BASE_URL=http://127.0.0.1:8000
PMS_CORS_ORIGINS=[]
PMS_METRICS_TOKEN=
# Staging/production use s3 or azure private object storage.
PMS_STORAGE_BUCKET=
PMS_AWS_REGION=ap-south-1
PMS_AZURE_STORAGE_ACCOUNT=
PMS_FFPROBE_PATH=ffprobe
PMS_EXPOSE_DOCS=true

# init-local, local startup and managed VM deployment provision this automatically.
# Persistent private Ed25519 PEM outside PostgreSQL; preserve across deployments.
# Other installations: pms-admin init-training --env-file /private/api.env
# PMS_TRAINING_KEY_FILE=/private/training-private.pem
PMS_TRAINING_LEASE_SECONDS=30

# Local llama.cpp adapter, same laptop as PMS. No cloud/model fallback.
PMS_LLM_ENABLED=false
PMS_LLM_ALLOWED_PORTS=[8787]
# Exact API base URLs; remote calls ALSO require PMS_EXTERNAL_CALLS_ENABLED=true.
PMS_LLM_ALLOWED_BASE_URLS=["https://api.openai.com/v1","https://api.anthropic.com/v1"]
PMS_LLM_TIMEOUT_SECONDS=120
# Readiness probes only, not inference. The probe is a credentialed GET of the model catalogue,
# so it is safe to repeat; a provider that misses one window is usually reachable a moment later.
# Worst case for a whole probe is ATTEMPTS x TIMEOUT plus 1 s of backoff.
PMS_HEALTH_TIMEOUT_SECONDS=5
PMS_HEALTH_ATTEMPTS=2
PMS_LLM_DAILY_REQUESTS=5000
# Per organization, combined provider input + output tokens; resets at 00:00 UTC.
PMS_LLM_DAILY_TOTAL_TOKENS=5000000
# Selected-case patient rehearsal; remote context must match the configured model.
PMS_PATIENT_LOCAL_CONTEXT_TOKENS=2048
# PMS_PATIENT_REMOTE_CONTEXT_TOKENS=8192

# Optional client-reported local conversation archive (no model calls).
PMS_LOCAL_HISTORY_ENABLED=true
PMS_LOCAL_HISTORY_UPLOAD_HOURS=24
PMS_LOCAL_HISTORY_RETENTION_DAYS=7
PMS_LOCAL_HISTORY_MAX_RECORDS=10000
PMS_LOCAL_HISTORY_MAX_BYTES=104857600

# Private session archives: bounded capacity, independently of processing submissions.
PMS_SESSION_ARCHIVE_SESSION_BYTES=536870912
PMS_SESSION_ARCHIVE_ORG_BYTES=5368709120

# Operator-published installer ZIPs, outside public assets and tenant media.
# Set an absolute persistent path on servers, e.g. /var/lib/pms-downloads.
PMS_DOWNLOADS_ROOT=.local/downloads
