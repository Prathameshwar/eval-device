# Raspberry Pi only. Copy privately to .env.agent. No laptop model/media credentials.
PI_PLATFORM_URL=https://platform.example
PI_LAPTOP_URL=https://training-laptop.example:8767
PI_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
PI_DEVICE_ID=00000000-0000-0000-0000-000000000000
PI_CREDENTIAL=replace-with-enrolled-device-credential
PI_PUBLIC_KEY_FILE=/private/training-public.pem
PI_CA_FILE=/private/deployment-ca.pem
PI_CAMERA_EXECUTABLE=rpicam-vid
# Optional sounddevice device names:
# PI_INPUT_DEVICE=USB Microphone
# PI_OUTPUT_DEVICE=USB Speaker
