# Laptop only. Copy to .env in a private directory; replace all identifiers/credentials.
TRAINING_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
TRAINING_DEVICE_ID=00000000-0000-0000-0000-000000000000
TRAINING_PLATFORM_URL=http://127.0.0.1:8000
TRAINING_PUBLIC_KEY_FILE=../../.local/training/keys/training-public.pem
TRAINING_DIALOGUE_KEY_FILE=../../.local/training/keys/model.key
TRAINING_DIALOGUE_URL=http://127.0.0.1:8780
TRAINING_SPEECH_EXECUTABLE=../../.local/training/espeak/eSpeak NG/espeak-ng.exe
TRAINING_ORIGIN=http://127.0.0.1:8767
TRAINING_AUDIO_URL=ws://127.0.0.1:8765/v1/audio/stream
TRAINING_AUDIO_TOKEN=replace-with-private-audio-client-token
TRAINING_VIDEO_URL=ws://127.0.0.1:8766/v1/video/stream
TRAINING_VIDEO_TOKEN=replace-with-private-video-client-token
TRAINING_VIDEO_CLIENT_ID=training
TRAINING_VIDEO_STORE=../video-process/.recordings-training
TRAINING_STORE=.recordings
# For remote platform HTTPS with a private CA:
# TRAINING_CA_FILE=/private/platform-ca.pem
