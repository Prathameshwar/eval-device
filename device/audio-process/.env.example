# Run uv run audio-api init-local to create a private .env with a random token.
AUDIO_CLIENT_TOKENS={}
AUDIO_HOST=127.0.0.1
AUDIO_PORT=8765
AUDIO_MODEL_NAME=large-v3
# AUDIO_MODEL_PATH=.models/large-v3
# Optional English medical model: setup-medical.bat, then restart.
# AUDIO_MODEL_NAME=whisper-medical-v1
# AUDIO_MODEL_PATH=.models/whisper-medical-v1
# Start language=en only; use multilingual Whisper for Hindi/Hinglish.
# Alternative CPU streaming model (download first; restart after selecting):
# AUDIO_MODEL_NAME=nemotron-3.5-asr-streaming-0.6b
# AUDIO_MODEL_PATH=.models/nemotron-3.5-asr-streaming-0.6b
# Use either the model's default path or a matching explicit path; remove stale overrides.
# Nemotron uses CPU INT8 greedy decoding; AUDIO_BEAM_SIZE is Whisper-only.
# Optional CPU Vosk (uv sync --extra vosk; download first):
# AUDIO_MODEL_NAME=vosk-model-small-en-us-0.15
# AUDIO_MODEL_PATH=.models/vosk-model-small-en-us-0.15
# Or vosk-model-small-hi-0.22. Start language must match en/hi; auto is unsupported.
# Vosk uses model-default decoding; CPU_THREADS and BEAM_SIZE do not apply.
# Bounded 150 ms streaming blocks: ceil(queue_ms / 150) queued blocks per connection.
AUDIO_STREAMING_QUEUE_MS=5000
# Optional NVIDIA GPU for Whisper only. Install: uv sync --extra cuda
# false = CPU INT8; true = CUDA INT8/FP16. Restart after changing.
# Nemotron and Vosk require false; requesting an unavailable GPU fails startup.
AUDIO_GPU_ENABLED=false
AUDIO_GPU_DEVICE_INDEX=0
AUDIO_CPU_THREADS=4
AUDIO_BEAM_SIZE=1
AUDIO_CONSOLE_OUTPUT=true
AUDIO_MAX_SESSIONS=2
AUDIO_CHUNK_QUEUE_SIZE=2
AUDIO_MAX_CHUNK_SECONDS=8
AUDIO_SILENCE_MS=600
AUDIO_PRE_ROLL_MS=300
AUDIO_MIN_SPEECH_MS=180
# Voice activity detection: silero is the neural detector bundled with faster-whisper, webrtc the
# older energy one. See docs/vad-engine-comparison.md; webrtc calls all audio speech below about
# 10 dB SNR, so questions end at MAX_CHUNK_SECONDS rather than at the speaker's pause.
AUDIO_VAD_ENGINE=silero
# Silero speech probability, 0.05-0.95. Raise it in a noisy room, lower it for quiet speakers.
AUDIO_VAD_THRESHOLD=0.5
# Optional silero weights override; unset uses the copy installed with faster-whisper.
# AUDIO_VAD_MODEL_PATH=.models/silero_vad_v6.onnx
# Aggressiveness 0-3, used only when AUDIO_VAD_ENGINE=webrtc.
AUDIO_VAD_AGGRESSIVENESS=2
AUDIO_MAX_AUDIO_SECONDS=600
AUDIO_MAX_SESSION_SECONDS=900
AUDIO_IDLE_TIMEOUT_SECONDS=30
AUDIO_INFERENCE_TIMEOUT_SECONDS=180
AUDIO_MODEL_LOAD_TIMEOUT_SECONDS=180
AUDIO_INFERENCE_SHUTDOWN_SECONDS=5
AUDIO_DRAIN_TIMEOUT_SECONDS=300
AUDIO_SEND_TIMEOUT_SECONDS=5
AUDIO_MAX_FRAME_BYTES=16000
# LAN binding requires both TLS files. Use a certificate the Pi verifies.
# AUDIO_TLS_CERT=path/to/server-cert.pem
# AUDIO_TLS_KEY=path/to/server-key.pem
# Optional future callback. URL cannot be supplied by the audio client.
# AUDIO_CALLBACK_URL=https://your-selected-receiver.example/transcripts
# AUDIO_CALLBACK_TOKEN=
AUDIO_CALLBACK_TIMEOUT_SECONDS=5
AUDIO_CALLBACK_QUEUE_SIZE=8
AUDIO_CALLBACK_WORKERS=2

# Private background recording; no disk wait on the transcription path.
AUDIO_RECORDING_ENABLED=true
AUDIO_RECORDING_DIR=.recordings
AUDIO_RECORDING_MAX_BYTES=1000000000
AUDIO_RECORDING_RETENTION_HOURS=168
AUDIO_RECORDING_MAX_SESSIONS=1000
AUDIO_RECORDING_QUEUE_ITEMS=256
AUDIO_RECORDING_QUEUE_BYTES=2097152
AUDIO_RECORDING_PENDING_SESSIONS=8
AUDIO_RECORDING_MIN_FREE_BYTES=67108864
AUDIO_RECORDING_FLUSH_SECONDS=1
AUDIO_RECORDING_CLEANUP_SECONDS=60
AUDIO_RECORDING_STARTUP_SECONDS=5
AUDIO_RECORDING_SHUTDOWN_SECONDS=5

# Bounded transient I/O and pre-submission callback retries.
AUDIO_RECORDING_RETRY_ATTEMPTS=3
AUDIO_RECORDING_RETRY_DELAY_SECONDS=0.05
AUDIO_CALLBACK_RETRY_ATTEMPTS=3
AUDIO_CALLBACK_RETRY_DELAY_SECONDS=0.2
