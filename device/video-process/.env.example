# Run `uv run video-api init-local` to create private .env credentials.
VIDEO_CLIENT_TOKENS={}
VIDEO_HOST=127.0.0.1
VIDEO_PORT=8766
# For Wi-Fi configure trusted TLS certificate/key before binding 0.0.0.0.
# VIDEO_TLS_CERT=path/to/server-cert.pem
# VIDEO_TLS_KEY=path/to/server-key.pem
VIDEO_MAX_SESSIONS=2
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_HEIGHT=720
VIDEO_MAX_FPS=15
VIDEO_MAX_FRAME_BYTES=524288
VIDEO_MAX_SESSION_SECONDS=600
VIDEO_IDLE_SECONDS=15
VIDEO_SEND_SECONDS=5
VIDEO_DISK_WAIT_SECONDS=5
VIDEO_QUEUE_BYTES=8388608
VIDEO_QUEUE_ITEMS=128
VIDEO_SEGMENT_BYTES=2097152
VIDEO_SEGMENT_SECONDS=2
VIDEO_RECORDING_DIR=.recordings
VIDEO_RECORDING_MAX_BYTES=1000000000
VIDEO_RECORDING_MAX_SESSIONS=1000
VIDEO_RETENTION_HOURS=168
VIDEO_MIN_FREE_BYTES=67108864
VIDEO_RETRY_ATTEMPTS=3
VIDEO_RETRY_DELAY_SECONDS=0.05
