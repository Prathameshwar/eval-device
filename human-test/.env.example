# Platform API and assigned models. Human-test never starts an API or model service.
# In a portable package, run Human-test.exe and enroll using the connection screen.
# In a source checkout, start/start-human-test.bat launches the same screen.
# Saved pairing in .local/platform-connection/connection.json supplies the API origin,
# device credential and organization/device IDs; leave manual credentials blank when paired.
HUMAN_PMS_URL=https://eval.centralindia.cloudapp.azure.com
HUMAN_PMS_TOKEN=
HUMAN_ORGANIZATION_ID=
# Optional department scope; enforced by the central API.
# HUMAN_DEPARTMENT_ID=<department UUID>
# Use the device's assigned speech/LLM models (also enforced by the connection launcher).
HUMAN_USE_PMS_MODELS=true
# Manual setup only: registered active device UUID. Platform Admin assigns its models.
HUMAN_DEVICE_ID=
# HUMAN_DEVICE_TOKEN=<enrolled device credential; keep private and never commit>

# Central inference connection for assigned local models (LLM, recognition and synthesis).
# Start the assigned services separately in Manage Local Models.
# Cloud model requests use the platform API; this port is only for local inference.
HUMAN_LOCAL_MODELS_PORT=8790
# For a portable package with local assignments, set the absolute path to the
# separately installed model manager's .manager directory. A source checkout
# defaults to the sibling local-models/.manager directory.
# The launcher reads client-key.txt there automatically; never use/copy the operator key.
# HUMAN_LOCAL_MODELS_STATE_DIR=C:/path/to/local-models/.manager
# Local/cloud routes, model names and CPU/GPU execution come from platform assignments
# and Manage Local Models. Do not configure native model ports, GPU layers or engines here.

HUMAN_LANGUAGE=en
# Editable whole-input ignore dictionary; changes take effect on the next utterance.
# Default: training-client's packaged input-ignore.json. Relative overrides use human-test/ as the base.
# HUMAN_INPUT_IGNORE_FILE=config/my-input-ignore.json
HUMAN_STREAMING=true
HUMAN_TIMEOUT_SECONDS=180
HUMAN_SPEAKER_OUTPUT=true
# Optional fixed voice key from Manage Local Models; unset follows patient sex and language
# HUMAN_VOICE=en-male-gb
HUMAN_MAX_QUESTION_SECONDS=30
HUMAN_SILENCE_MS=800
# The speech gate's lower bound, not the whole gate: a quiet room uses exactly this value, and a
# noisy one raises the bar to NOISE_MULTIPLIER x the measured room floor, capped at ENERGY_CEILING.
HUMAN_ENERGY_THRESHOLD=400
HUMAN_ENERGY_CEILING=5000
HUMAN_NOISE_MULTIPLIER=3.0
# Room-noise measurement taken at the start of each question, before speech is expected.
HUMAN_CALIBRATION_MS=300
# Consecutive 50 ms voiced blocks before a silence may end the question. Raise it if coughs,
# chair scrapes or door noise end questions early.
HUMAN_MIN_VOICED_BLOCKS=3
# Blocks (50 ms each) the capture may lose to a stalled loop or device overrun before the turn is
# refused. Below this the question is still sent, with the loss reported in the app.
HUMAN_MAX_LOST_BLOCKS=20
# Initial silence before capture gives up on a question. Applies only before any speech is
# detected, and must stay below HUMAN_MAX_QUESTION_SECONDS.
HUMAN_NO_SPEECH_SECONDS=5
# Cloud speech: five retries per round, with this additional pause between rounds.
# The same recording is retained; only explicit capacity rejections are retried.
HUMAN_SPEECH_RETRY_ROUNDS=10
HUMAN_SPEECH_RETRY_ROUND_PAUSE_SECONDS=3
# Preferred by name, because device indices reorder across reboots and USB re-enumeration.
# HUMAN_MICROPHONE_NAME=Headset (Jabra Evolve2)
# Camera is always off at startup; enable Capture & show video in Conversation.
HUMAN_CAMERA_INDEX=0
# Default: human-test/.local/video-recordings; relative paths are based on human-test/.
# HUMAN_VIDEO_RECORDING_DIR=D:/PrivateRecordings/patient-practice
HUMAN_VIDEO_MAX_SESSION_SECONDS=3600
HUMAN_VIDEO_QUOTA_MB=5120
HUMAN_VIDEO_MIN_FREE_MB=512

# Session recording sync: default for enrolled devices, local and cloud models.
# Uploads pause during microphone use, inference, playback and camera capture.
HUMAN_SESSION_SYNC_ENABLED=true
HUMAN_SESSION_SYNC_BACKGROUND=true
# HUMAN_SESSION_SYNC_DIR=.local/session-sync
HUMAN_SESSION_SYNC_MAX_BYTES=5368709120
HUMAN_SESSION_SYNC_BYTES_PER_SECOND=524288

# Conversation text/result history; enabled by default, independently of recording sync.
# Set false to opt out of this history outbox; it does not disable recording sync above.
HUMAN_HISTORY_ENABLED=true
# HUMAN_HISTORY_DIR=.local/conversation-outbox
HUMAN_HISTORY_QUEUE_RECORDS=64
HUMAN_HISTORY_QUEUE_BYTES=8388608
HUMAN_HISTORY_MAX_RECORDS=1000
HUMAN_HISTORY_MAX_BYTES=67108864
HUMAN_HISTORY_PENDING_HOURS=24
